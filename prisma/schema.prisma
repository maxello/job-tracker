generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

// Minimal until M2, when the auth library defines the real shape.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String         @db.VarChar(200)
  role           String         @db.VarChar(200)
  url            String?        @db.VarChar(2048)
  notes          String?        @db.Text
  location       String?        @db.VarChar(200)
  level          String?        @db.VarChar(100)
  stack          String[]       @default([])
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?        @db.Char(3)
  status         Status         @default(WISHLIST)
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  statusChanges  StatusChange[]

  @@index([userId, updatedAt])
  @@index([userId, status])
}

// No userId: always accessed through an Application already checked for ownership.
model StatusChange {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          Status?
  to            Status
  changedAt     DateTime    @default(now())

  @@index([applicationId, changedAt])
}
