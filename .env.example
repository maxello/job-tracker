# Used by the app (Neon's pooled URL on Vercel)
DATABASE_URL=
# Used by Prisma CLI migrations (Neon's direct URL); optional locally, falls back to DATABASE_URL.
# When set, the Prisma CLI uses it instead of DATABASE_URL: to target another database by hand, set both.
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
ANTHROPIC_API_KEY=
PARSE_MODEL=